NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

DATABASE_URL="postgresql://novastore:novastore@localhost:5432/novastore?schema=public"
REDIS_URL="redis://localhost:6379"

# Supabase: dùng SUPABASE_URL để xác minh JWT qua JWKS (khóa bất đối xứng — khuyến nghị).
# Chỉ đặt SUPABASE_JWT_SECRET nếu project còn dùng legacy HS256 secret.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_JWT_SECRET=""
JWT_AUDIENCE="authenticated"

CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# Bắt buộc MFA (aal2) cho route Moderator/Admin. Mặc định: true khi NODE_ENV=production.
REQUIRE_STAFF_MFA=false

# Bí mật HMAC để băm IP trong audit log (>= 32 ký tự). Bắt buộc đổi ở production.
IP_HASH_SECRET="dev-only-ip-hash-secret-change-me-0000"

TRUST_PROXY=false
SENTRY_DSN=""

# Swagger UI tại /api/docs, JSON tại /api/openapi.json. Mặc định bật ngoài production.
OPENAPI_ENABLED=true
