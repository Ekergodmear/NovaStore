// NovaStore — Prisma schema. Nguồn thiết kế: docs/DATABASE_SCHEMA.md
// Các phần Prisma không biểu diễn được (generated tsvector, trigger append-only,
// index biểu thức) nằm trong SQL migration.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, unaccent, pg_trgm]
}

// ───────────────────────────── Identity ─────────────────────────────

enum UserStatus {
  active
  suspended
  deleted

  @@map("user_status")
}

enum PlatformRole {
  user
  moderator
  admin

  @@map("platform_role")
}

enum DeveloperVerificationStatus {
  unverified
  email_verified
  verified

  @@map("developer_verification_status")
}

enum DeveloperStatus {
  active
  suspended
  banned

  @@map("developer_status")
}

enum DeveloperMemberRole {
  owner
  admin
  editor

  @@map("developer_member_role")
}

/// Bản sao tối thiểu của user Supabase; id = auth.users.id.
model User {
  id          String     @id @db.Uuid
  email       String?    @unique @db.Citext
  displayName String?    @map("display_name")
  avatarUrl   String?    @map("avatar_url")
  status      UserStatus @default(active)
  lastSeenAt  DateTime?  @map("last_seen_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles             UserRole[]
  memberships       DeveloperMember[]
  releasesCreated   AppRelease[]
  moderationReviews ModerationReview[]
  reviews           AppReview[]
  reportsFiled      AppReport[]        @relation("ReportReporter")
  reportsHandled    AppReport[]        @relation("ReportHandler")
  auditLogs         AuditLog[]

  @@map("users")
}

model UserRole {
  userId    String       @map("user_id") @db.Uuid
  role      PlatformRole
  grantedBy String?      @map("granted_by") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

model DeveloperAccount {
  id                  String                      @id @default(uuid(7)) @db.Uuid
  slug                String                      @unique @db.Citext
  displayName         String                      @map("display_name")
  contactEmail        String                      @map("contact_email") @db.Citext
  website             String?
  verificationStatus  DeveloperVerificationStatus @default(unverified) @map("verification_status")
  status              DeveloperStatus             @default(active)
  agreementVersion    String                      @map("agreement_version")
  agreementAcceptedAt DateTime                    @map("agreement_accepted_at") @db.Timestamptz(6)
  createdAt           DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  members       DeveloperMember[]
  apps          App[]
  reviewReplies ReviewReply[]

  @@map("developer_accounts")
}

model DeveloperMember {
  developerAccountId String              @map("developer_account_id") @db.Uuid
  userId             String              @map("user_id") @db.Uuid
  memberRole         DeveloperMemberRole @default(owner) @map("member_role")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  developerAccount DeveloperAccount @relation(fields: [developerAccountId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([developerAccountId, userId])
  @@index([userId])
  @@map("developer_members")
}

// ───────────────────────────── Catalog ─────────────────────────────

enum ContentRating {
  everyone
  teen
  mature

  @@map("content_rating")
}

enum AppStatus {
  draft
  in_review
  published
  unlisted
  removed

  @@map("app_status")
}

enum MediaType {
  icon
  feature_graphic
  screenshot_phone
  screenshot_tablet

  @@map("media_type")
}

enum MediaStatus {
  pending
  approved
  rejected

  @@map("media_status")
}

model AppCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique
  nameVi    String   @map("name_vi")
  nameEn    String   @map("name_en")
  icon      String?
  sortOrder Int      @default(0) @map("sort_order")
  parentId  String?  @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   AppCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children AppCategory[] @relation("CategoryTree")
  apps     App[]

  @@map("app_categories")
}

model App {
  id                  String        @id @default(uuid(7)) @db.Uuid
  developerAccountId  String        @map("developer_account_id") @db.Uuid
  /// Null cho tới khi release đầu tiên được duyệt; sau đó khóa vĩnh viễn, không tái sử dụng.
  packageName         String?       @unique @map("package_name")
  pendingPackageName  String?       @map("pending_package_name")
  /// SHA-256 các chứng chỉ ký hợp lệ (gốc + rotation v3).
  signerLineageSha256 String[]      @default([]) @map("signer_lineage_sha256")
  slug                String        @unique @db.Citext
  title               String        @db.VarChar(50)
  shortDescription    String        @map("short_description") @db.VarChar(80)
  fullDescription     String        @map("full_description") @db.VarChar(4000)
  categoryId          String        @map("category_id") @db.Uuid
  contentRating       ContentRating @default(everyone) @map("content_rating")
  containsAds         Boolean       @default(false) @map("contains_ads")
  privacyPolicyUrl    String?       @map("privacy_policy_url")
  defaultLocale       String        @default("vi") @map("default_locale")
  status              AppStatus     @default(draft)
  removedReason       String?       @map("removed_reason")
  currentReleaseId    String?       @unique @map("current_release_id") @db.Uuid
  ratingAvg           Decimal       @default(0) @map("rating_avg") @db.Decimal(2, 1)
  ratingCount         Int           @default(0) @map("rating_count")
  downloadCount       BigInt        @default(0) @map("download_count")
  /// Cột generated (xem migration); không ghi từ ứng dụng.
  searchVector        Unsupported("tsvector")? @map("search_vector")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  developerAccount DeveloperAccount @relation(fields: [developerAccountId], references: [id])
  category         AppCategory      @relation(fields: [categoryId], references: [id])
  currentRelease   AppRelease?      @relation("CurrentRelease", fields: [currentReleaseId], references: [id])
  releases         AppRelease[]     @relation("AppReleases")
  media            AppMedia[]
  reviews          AppReview[]
  reports          AppReport[]
  downloadEvents   DownloadEvent[]
  dailyStats       AppDailyStat[]

  @@index([developerAccountId])
  @@index([status, categoryId, downloadCount(sort: Desc)])
  @@map("apps")
}

model AppMedia {
  id        String      @id @default(uuid(7)) @db.Uuid
  appId     String      @map("app_id") @db.Uuid
  type      MediaType
  r2Key     String      @map("r2_key")
  width     Int
  height    Int
  sha256    String      @db.Char(64)
  sortOrder Int         @default(0) @map("sort_order")
  status    MediaStatus @default(pending)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, type, sortOrder])
  @@map("app_media")
}

// ───────────────────────────── Release ─────────────────────────────

enum ReleaseStatus {
  draft
  uploading
  processing
  pending_review
  approved
  rejected
  published
  superseded
  revoked

  @@map("release_status")
}

enum ScanVerdict {
  pass
  warn
  fail
  error

  @@map("scan_verdict")
}

enum ModerationDecision {
  approve
  reject
  request_changes

  @@map("moderation_decision")
}

model AppRelease {
  id                  String        @id @default(uuid(7)) @db.Uuid
  appId               String        @map("app_id") @db.Uuid
  /// Null cho tới khi worker trích xuất từ APK.
  versionCode         BigInt?       @map("version_code")
  versionName         String?       @map("version_name")
  changelogVi         String?       @map("changelog_vi") @db.VarChar(500)
  changelogEn         String?       @map("changelog_en") @db.VarChar(500)
  status              ReleaseStatus @default(draft)
  rejectionReasonCode String?       @map("rejection_reason_code")
  rejectionNote       String?       @map("rejection_note")
  submittedAt         DateTime?     @map("submitted_at") @db.Timestamptz(6)
  approvedAt          DateTime?     @map("approved_at") @db.Timestamptz(6)
  publishedAt         DateTime?     @map("published_at") @db.Timestamptz(6)
  revokedAt           DateTime?     @map("revoked_at") @db.Timestamptz(6)
  revokeReason        String?       @map("revoke_reason")
  createdById         String        @map("created_by") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  app               App                 @relation("AppReleases", fields: [appId], references: [id])
  currentForApp     App?                @relation("CurrentRelease")
  createdBy         User                @relation(fields: [createdById], references: [id])
  artifact          ReleaseArtifact?
  scanResults       ReleaseScanResult[]
  moderationReviews ModerationReview[]
  reports           AppReport[]
  downloadEvents    DownloadEvent[]

  @@unique([appId, versionCode])
  @@index([status, submittedAt])
  @@map("app_releases")
}

/// Bất biến sau khi tạo. Thay đổi = release mới.
model ReleaseArtifact {
  id                    String   @id @default(uuid(7)) @db.Uuid
  releaseId             String   @unique @map("release_id") @db.Uuid
  quarantineKey         String   @map("quarantine_key")
  publicKey             String?  @map("public_key")
  sizeBytes             BigInt   @map("size_bytes")
  sha256                String   @db.Char(64)
  packageName           String   @map("package_name")
  versionCode           BigInt   @map("version_code")
  versionName           String   @map("version_name")
  minSdk                Int      @map("min_sdk")
  targetSdk             Int      @map("target_sdk")
  permissions           String[] @default([])
  features              String[] @default([])
  nativeAbis            String[] @default([]) @map("native_abis")
  signingSchemes        String[] @default([]) @map("signing_schemes")
  signerCertSha256      String[] @default([]) @map("signer_cert_sha256")
  signerLineage         Json?    @map("signer_lineage")
  manifestSummary       Json     @default("{}") @map("manifest_summary")
  uploadedSha256Claimed String?  @map("uploaded_sha256_claimed") @db.Char(64)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  release AppRelease @relation(fields: [releaseId], references: [id])

  @@index([sha256])
  @@index([packageName])
  @@map("release_artifacts")
}

model ReleaseScanResult {
  id             String      @id @default(uuid(7)) @db.Uuid
  releaseId      String      @map("release_id") @db.Uuid
  scanner        String
  scannerVersion String      @map("scanner_version")
  verdict        ScanVerdict
  riskScore      Int         @default(0) @map("risk_score")
  findings       Json        @default("[]")
  startedAt      DateTime    @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?   @map("finished_at") @db.Timestamptz(6)

  release AppRelease @relation(fields: [releaseId], references: [id])

  @@index([releaseId])
  @@map("release_scan_results")
}

/// Append-only; quyết định mới nhất có hiệu lực.
model ModerationReview {
  id           String             @id @default(uuid(7)) @db.Uuid
  releaseId    String             @map("release_id") @db.Uuid
  moderatorId  String             @map("moderator_id") @db.Uuid
  decision     ModerationDecision
  reasonCode   String?            @map("reason_code")
  note         String?
  checklist    Json               @default("{}")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  release   AppRelease @relation(fields: [releaseId], references: [id])
  moderator User       @relation(fields: [moderatorId], references: [id])

  @@index([releaseId, createdAt])
  @@map("moderation_reviews")
}

// ───────────────────────────── Community ─────────────────────────────

enum ReviewStatus {
  visible
  hidden
  removed

  @@map("review_status")
}

enum ReportReason {
  malware
  impersonation
  copyright
  inappropriate
  privacy
  other

  @@map("report_reason")
}

enum ReportStatus {
  open
  triaged
  actioned
  dismissed

  @@map("report_status")
}

model AppReview {
  id          String       @id @default(uuid(7)) @db.Uuid
  appId       String       @map("app_id") @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  rating      Int          @db.SmallInt
  body        String?      @db.VarChar(1000)
  versionCode BigInt?      @map("version_code")
  status      ReviewStatus @default(visible)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  app   App          @relation(fields: [appId], references: [id])
  user  User         @relation(fields: [userId], references: [id])
  reply ReviewReply?

  @@unique([appId, userId])
  @@index([appId, status, createdAt(sort: Desc)])
  @@map("app_reviews")
}

model ReviewReply {
  reviewId           String   @id @map("review_id") @db.Uuid
  developerAccountId String   @map("developer_account_id") @db.Uuid
  body               String   @db.VarChar(1000)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  review           AppReview        @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  developerAccount DeveloperAccount @relation(fields: [developerAccountId], references: [id])

  @@map("review_replies")
}

model AppReport {
  id             String       @id @default(uuid(7)) @db.Uuid
  appId          String       @map("app_id") @db.Uuid
  releaseId      String?      @map("release_id") @db.Uuid
  reporterId     String?      @map("reporter_id") @db.Uuid
  reason         ReportReason
  details        String?      @db.VarChar(2000)
  status         ReportStatus @default(open)
  handledById    String?      @map("handled_by") @db.Uuid
  resolutionNote String?      @map("resolution_note")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  app       App         @relation(fields: [appId], references: [id])
  release   AppRelease? @relation(fields: [releaseId], references: [id])
  reporter  User?       @relation("ReportReporter", fields: [reporterId], references: [id])
  handledBy User?       @relation("ReportHandler", fields: [handledById], references: [id])

  @@index([status, createdAt])
  @@index([appId])
  @@map("app_reports")
}

// ───────────────────────────── Analytics ─────────────────────────────

enum DownloadClient {
  web
  android_store

  @@map("download_client")
}

/// Append-only. Không lưu IP thô: client_fingerprint = HMAC(ip/24 + UA + ngày).
model DownloadEvent {
  id                BigInt         @id @default(autoincrement())
  appId             String         @map("app_id") @db.Uuid
  releaseId         String         @map("release_id") @db.Uuid
  userId            String?        @map("user_id") @db.Uuid
  client            DownloadClient
  clientFingerprint String         @map("client_fingerprint") @db.Char(64)
  country           String?        @db.Char(2)
  isCounted         Boolean        @default(true) @map("is_counted")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  app     App        @relation(fields: [appId], references: [id])
  release AppRelease @relation(fields: [releaseId], references: [id])

  @@index([appId, createdAt])
  @@index([clientFingerprint, appId, createdAt])
  @@map("download_events")
}

model AppDailyStat {
  appId           String   @map("app_id") @db.Uuid
  date            DateTime @db.Date
  downloads       Int      @default(0)
  uniqueDownloads Int      @default(0) @map("unique_downloads")
  newReviews      Int      @default(0) @map("new_reviews")
  ratingSum       Int      @default(0) @map("rating_sum")

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@id([appId, date])
  @@map("app_daily_stats")
}

// ───────────────────────────── Audit ─────────────────────────────

/// Append-only, được bảo vệ bằng trigger chặn UPDATE/DELETE (xem migration).
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String?  @map("actor_role")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  before     Json?
  after      Json?
  ipHash     String?  @map("ip_hash") @db.Char(64)
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
