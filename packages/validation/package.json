{
  "name": "@novastore/validation",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@novastore/types": "workspace:*",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@novastore/config": "workspace:*",
    "@types/node": "^22.18.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
